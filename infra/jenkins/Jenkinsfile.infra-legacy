/**
 * SoftMusic — Deploy INFRA LEGACY (MariaDB 10.5.28 para CPUs antigas)
 *
 * Igual ao Jenkinsfile.infra, porém com MariaDB 10.5.28 quando INSTALL_MYSQL=1.
 * Com INSTALL_MYSQL=0 usa banco externo (mesmo fluxo do job padrão).
 *
 * O Jenkins roda em container e faz o deploy local (via socket do host).
 * Segredos: credenciais "Secret text".
 */
pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    choice(
      name: 'INSTALL_MYSQL',
      choices: ['1', '0'],
      description: '1 = MariaDB no Docker | 0 = banco EXTERNO (DigitalOcean). Se MYSQL_HOST for FQDN/IP, força externo automaticamente.'
    )
    string(
      name: 'MYSQL_HOST',
      defaultValue: '',
      description: 'Host externo (ex.: db-mysql-nyc3-xxxxx.db.ondigitalocean.com). Vazio = container local (mysql)'
    )
    string(
      name: 'MYSQL_PORT',
      defaultValue: '25060',
      description: 'Porta. DigitalOcean: 25060. Local (INSTALL_MYSQL=1): use 3307'
    )
    string(
      name: 'MYSQL_DATABASE',
      defaultValue: 'softmusic',
      description: 'Nome do database'
    )
    string(
      name: 'MYSQL_USER',
      defaultValue: 'softmusic',
      description: 'Usuário da aplicação no MySQL'
    )
    choice(
      name: 'MYSQL_SSL',
      choices: ['auto', '1', '0'],
      description: 'SSL na DATABASE_URL. auto = liga quando INSTALL_MYSQL=0 (recomendado na DigitalOcean)'
    )
  }

  environment {
    DEPLOY_DIR         = "${env.DEPLOY_DIR ?: '/var/jenkins_home/deploy/softmusic'}"
    DEPLOY_DIR_HOST    = "${env.DEPLOY_DIR_HOST ?: '/dados/jenkins_home/deploy/softmusic'}"
    WITH_OBSERVABILITY = '1'
    LEGACY_MYSQL       = '1'
    INSTALL_MYSQL      = "${params.INSTALL_MYSQL}"
    MYSQL_HOST         = "${params.MYSQL_HOST}"
    MYSQL_PORT         = "${params.MYSQL_PORT}"
    MYSQL_DATABASE     = "${params.MYSQL_DATABASE}"
    MYSQL_USER         = "${params.MYSQL_USER}"
    MYSQL_SSL          = "${params.MYSQL_SSL}"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Gerar .env de produção') {
      steps {
        withCredentials([
          string(credentialsId: 'softmusic-mysql-root-password',    variable: 'MYSQL_ROOT_PASSWORD'),
          string(credentialsId: 'softmusic-mysql-password',         variable: 'MYSQL_PASSWORD'),
          string(credentialsId: 'softmusic-redis-password',         variable: 'REDIS_PASSWORD'),
          string(credentialsId: 'softmusic-rabbitmq-password',      variable: 'RABBITMQ_PASSWORD'),
          string(credentialsId: 'softmusic-jwt-private-key',        variable: 'JWT_PRIVATE_KEY'),
          string(credentialsId: 'softmusic-grafana-admin-password', variable: 'GRAFANA_ADMIN_PASSWORD'),
        ]) {
          sh 'bash infra/docker/scripts/render-env.sh'
        }
      }
    }

    stage('Deploy infra') {
      steps {
        sh 'bash infra/docker/scripts/deploy-infra.sh'
      }
    }
  }

  post {
    success {
      script {
        if (params.INSTALL_MYSQL == '0') {
          echo "Infra SoftMusic LEGACY provisionada (MySQL EXTERNO: ${params.MYSQL_HOST}:${params.MYSQL_PORT})."
        } else {
          echo 'Infra SoftMusic LEGACY (MariaDB 10.5.28) provisionada com sucesso.'
        }
      }
    }
    failure { echo 'Falha no deploy LEGACY. Veja o ERRO acima: credencial ausente no estágio ".env" ou imagem/compose com problema.' }
  }
}
