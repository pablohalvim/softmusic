/**
 * SoftMusic — Deploy da IA (python-ai + worker + scheduler)
 *
 * Jenkins em container: builda a imagem LOCALMENTE no daemon do host (sem push)
 * e sobe python-ai/worker/scheduler. As MIGRATIONS do banco são aplicadas no
 * entrypoint do python-ai (alembic upgrade head) — este é o job que migra o
 * schema. Segredos: credenciais "Secret text".
 *
 * MySQL: por padrão reusa INSTALL_MYSQL/MYSQL_* do .env gerado pela infra.
 * Preencha os parâmetros abaixo para apontar (ou corrigir) o banco DigitalOcean.
 */
pipeline {
  agent any

  parameters {
    choice(
      name: 'IA_COMPUTE',
      choices: ['cpu', 'gpu'],
      description: 'cpu = padrão (sem NVIDIA) · gpu = runtime nvidia (exige driver + NVIDIA Container Toolkit no host)'
    )
    choice(
      name: 'INSTALL_MYSQL',
      choices: ['', '0', '1'],
      description: 'Vazio = manter o .env da infra | 0 = banco EXTERNO (DigitalOcean) | 1 = MySQL local no Docker'
    )
    string(
      name: 'MYSQL_HOST',
      defaultValue: '',
      description: 'Host DigitalOcean (ex.: db-mysql-nyc3-xxxxx.db.ondigitalocean.com). Vazio = mantém o .env da infra'
    )
    string(
      name: 'MYSQL_PORT',
      defaultValue: '',
      description: 'Porta MySQL. DigitalOcean: 25060. Vazio = mantém o .env da infra'
    )
    string(
      name: 'MYSQL_DATABASE',
      defaultValue: '',
      description: 'Nome do database. Vazio = mantém o .env / default softmusic'
    )
    string(
      name: 'MYSQL_USER',
      defaultValue: '',
      description: 'Usuário MySQL da app. Vazio = mantém o .env / default softmusic'
    )
    choice(
      name: 'MYSQL_SSL',
      choices: ['', 'auto', '1', '0'],
      description: 'Vazio = manter .env | auto = SSL se banco externo | 1/0 força'
    )
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    DEPLOY_DIR      = "${env.DEPLOY_DIR ?: '/var/jenkins_home/deploy/softmusic'}"
    DEPLOY_DIR_HOST = "${env.DEPLOY_DIR_HOST ?: '/dados/jenkins_home/deploy/softmusic'}"
    IMAGE_TAG       = "${env.BUILD_NUMBER ?: 'latest'}"
    IMAGE_PREFIX    = 'softmusic'
    USE_GPU         = "${(params.IA_COMPUTE ?: 'cpu') == 'gpu' ? '1' : '0'}"
    // Object storage (Cloudflare R2). Endpoint = https://<account_id>.r2.cloudflarestorage.com
    S3_ENDPOINT_URL = "${env.S3_ENDPOINT_URL ?: 'https://9939081e6ba254ac6535099e21fbab2a.r2.cloudflarestorage.com'}"
    STORAGE_BUCKET  = "${env.STORAGE_BUCKET ?: 'softmusic'}"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build imagem (local)') {
      steps {
        sh '''
          bash infra/docker/scripts/docker-build.sh -f infra/docker/Dockerfile.python-ai \
            -t ${IMAGE_PREFIX}/python-ai:${IMAGE_TAG} \
            -t ${IMAGE_PREFIX}/python-ai:latest \
            .
        '''
      }
    }

    stage('Gerar .env de produção') {
      steps {
        script {
          // Só exporta overrides preenchidos; vazio = render-env reusa .env da infra
          if (params.INSTALL_MYSQL?.trim()) { env.INSTALL_MYSQL = params.INSTALL_MYSQL.trim() }
          if (params.MYSQL_HOST?.trim()) {
            env.MYSQL_HOST = params.MYSQL_HOST.trim()
            if (!params.INSTALL_MYSQL?.trim()) { env.INSTALL_MYSQL = '0' }
          }
          if (params.MYSQL_PORT?.trim()) { env.MYSQL_PORT = params.MYSQL_PORT.trim() }
          if (params.MYSQL_DATABASE?.trim()) { env.MYSQL_DATABASE = params.MYSQL_DATABASE.trim() }
          if (params.MYSQL_USER?.trim()) { env.MYSQL_USER = params.MYSQL_USER.trim() }
          if (params.MYSQL_SSL?.trim()) { env.MYSQL_SSL = params.MYSQL_SSL.trim() }

          if (env.MYSQL_HOST) {
            echo "MySQL override: host=${env.MYSQL_HOST} port=${env.MYSQL_PORT ?: '(default)'} install=${env.INSTALL_MYSQL ?: '0'} ssl=${env.MYSQL_SSL ?: 'auto'}"
          } else {
            echo 'MySQL: reusando INSTALL_MYSQL/MYSQL_* do .env.production (infra)'
          }

          def requiredCreds = [
            string(credentialsId: 'softmusic-mysql-root-password',      variable: 'MYSQL_ROOT_PASSWORD'),
            string(credentialsId: 'softmusic-mysql-password',           variable: 'MYSQL_PASSWORD'),
            string(credentialsId: 'softmusic-redis-password',           variable: 'REDIS_PASSWORD'),
            string(credentialsId: 'softmusic-rabbitmq-password',        variable: 'RABBITMQ_PASSWORD'),
            string(credentialsId: 'softmusic-jwt-private-key',          variable: 'JWT_PRIVATE_KEY'),
            string(credentialsId: 'softmusic-admin-jwt-private-key',    variable: 'ADMIN_JWT_PRIVATE_KEY'),
            string(credentialsId: 'softmusic-admin-bootstrap-password', variable: 'ADMIN_BOOTSTRAP_PASSWORD'),
            string(credentialsId: 'softmusic-asaas-api-key',            variable: 'ASAAS_API_KEY'),
            string(credentialsId: 'softmusic-asaas-webhook-token',      variable: 'ASAAS_WEBHOOK_TOKEN'),
            string(credentialsId: 'softmusic-grafana-admin-password',   variable: 'GRAFANA_ADMIN_PASSWORD'),
            string(credentialsId: 'softmusic-r2-access-key-id',         variable: 'S3_ACCESS_KEY_ID'),
            string(credentialsId: 'softmusic-r2-secret-access-key',     variable: 'S3_SECRET_ACCESS_KEY'),
          ]
          withCredentials(requiredCreds) {
            def rendered = false
            try {
              withCredentials([string(credentialsId: 'softmusic-resend-api-key', variable: 'RESEND_API_KEY')]) {
                sh 'bash infra/docker/scripts/render-env.sh'
                rendered = true
              }
            } catch (Exception e) {
              echo "AVISO: softmusic-resend-api-key ausente — e-mails desabilitados. Cadastre a credencial quando for usar Resend."
            }
            if (!rendered) {
              sh 'bash infra/docker/scripts/render-env.sh'
            }
          }
        }
      }
    }

    stage('Deploy IA (aplica migrations)') {
      steps {
        echo "Modo de compute: ${params.IA_COMPUTE} (USE_GPU=${USE_GPU})"
        sh 'bash infra/docker/scripts/deploy-ia.sh'
      }
    }
  }

  post {
    success {
      sh 'docker image prune -f || true'
      echo 'IA SoftMusic deployada e migrations aplicadas.'
    }
    failure { echo 'Falha no deploy da IA. Verifique os logs acima.' }
  }
}
