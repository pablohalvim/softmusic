# SoftMusic — .env de produção (REFERÊNCIA)
#
# Em produção este arquivo é GERADO pelo `infra/docker/scripts/render-env.sh`
# a partir das credenciais Jenkins (Secret text) + defaults. Você não precisa
# criá-lo à mão. Este exemplo serve para saber quais chaves existem e para
# deploy manual (sem Jenkins). Nunca commite o arquivo real com senhas.

NODE_ENV=production
SOFTMUSIC_ENV=production
LOG_LEVEL=info

# Domínios
WEB_ORIGIN=https://app.softmusic.com.br
API_BASE_URL=https://app.softmusic.com.br/api
VITE_API_URL=https://app.softmusic.com.br/api
VITE_APP_URL=https://app.softmusic.com.br
# Google Maps JS + Places — configure no Jenkins/credencial; não commitar a chave real.
VITE_GOOGLE_MAPS_API_KEY=
LP_ORIGIN=https://softmusic.com.br
ADMIN_ORIGIN=https://admin.softmusic.com.br
VITE_ADMIN_API_URL=https://admin.softmusic.com.br/api

# MySQL
MYSQL_ROOT_PASSWORD=s0ft1Mus1C20
MYSQL_DATABASE=softmusic
MYSQL_USER=softmusic
MYSQL_PASSWORD=s0ft1Mus1C20
# 1 = MySQL no Docker | 0 = banco externo (DigitalOcean etc.)
INSTALL_MYSQL=1
MYSQL_HOST=mysql
MYSQL_PORT=3307
MYSQL_SSL=0
DATABASE_URL=mysql+aiomysql://softmusic:s0ft1Mus1C20@mysql:3307/softmusic

# Exemplo DigitalOcean Managed MySQL (INSTALL_MYSQL=0):
# INSTALL_MYSQL=0
# MYSQL_HOST=db-mysql-nyc3-xxxxx.db.ondigitalocean.com
# MYSQL_PORT=25060
# MYSQL_SSL=1
# DATABASE_URL=mysql+aiomysql://softmusic:SENHA@db-mysql-nyc3-xxxxx.db.ondigitalocean.com:25060/softmusic?ssl=true
# (?ssl=true é convertido em connect_args SSL no python-ai; não passe ssl como string crua ao PyMySQL)

# Redis / RabbitMQ
REDIS_PASSWORD=s0ft1Mus1C20
REDIS_URL=redis://:s0ft1Mus1C20@redis:6379/0
RABBITMQ_USER=softmusic
RABBITMQ_PASSWORD=s0ft1Mus1C20
CELERY_BROKER_URL=amqp://softmusic:s0ft1Mus1C20@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:s0ft1Mus1C20@redis:6379/1

# JWT
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=6fafbe27-82cb-4893-bff4-7a22961dad87
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_PRIVATE_KEY=8ede7d0d-6531-4deb-b4af-cfd2d2562f58
ADMIN_BOOTSTRAP_EMAIL=admin@softmusic.com.br
ADMIN_BOOTSTRAP_PASSWORD=s0ft1Mus1C20
ADMIN_BOOTSTRAP_NAME=Administrador

# Asaas
ASAAS_API_KEY=s0ft1Mus1C20
ASAAS_ENVIRONMENT=production
ASAAS_WEBHOOK_TOKEN=s0ft1Mus1C20

# E-mail (Resend — preferido). Sem RESEND_API_KEY os e-mails são ignorados
# (convites, cobrança, marketing). Domínio precisa estar verificado no Resend.
RESEND_API_KEY=SUBSTITUA_RESEND_API_KEY
EMAIL_FROM="SoftMusic <administrativo@softmusic.com.br>"
# Fallback SMTP (opcional — só usado se RESEND_API_KEY estiver vazio)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Imagens Docker (build LOCAL no daemon do host, sem registry). Cada job marca
# a imagem como :latest; os deploys usam --force-recreate para pegar a nova.
SOFTMUSIC_API_IMAGE=softmusic/api:latest
SOFTMUSIC_PYTHON_AI_IMAGE=softmusic/python-ai:latest
SOFTMUSIC_WEB_IMAGE=softmusic/web:latest
SOFTMUSIC_LP_IMAGE=softmusic/lp:latest
SOFTMUSIC_ADMIN_WEB_IMAGE=softmusic/admin-web:latest

# Observabilidade
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=s0ft1Mus1C20
GRAFANA_ROOT_URL=https://grafana.softmusic.com.br
GRAFANA_CSRF_TRUSTED_ORIGINS=grafana.softmusic.com.br,https://grafana.softmusic.com.br
GRAFANA_CSRF_ADDITIONAL_HEADERS=X-Forwarded-Host

# IA / GPU
CELERY_CONCURRENCY=1
CUDA_VISIBLE_DEVICES=0
# Obrigatório para o toolkit expor a GPU no container (vazio = zero GPUs).
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
# 1 = Demucs no worker com CUDA (obrigatório em servidor com GPU).
# Se o Jenkins rodar IA_COMPUTE=cpu, o deploy força CPU mesmo com driver instalado.
USE_GPU=1
# 1 = permite cair em CPU se a GPU falhar (NÃO recomendado em produção — trava o app).
ALLOW_CPU_FALLBACK=0
# Limita CPU residual do worker (librosa/I/O) para não matar a API no mesmo host.
TORCH_NUM_THREADS=2
WORKER_CPUS=3.0
WORKER_MEM_LIMIT=8g
DEMUCS_ENABLED=true

# Object storage (Cloudflare R2 / S3-compatível). Deixe S3_* vazio para usar
# apenas disco local (volume Docker). Preencha as credenciais para habilitar o
# R2 (o render-env.sh liga STORAGE_PROVIDER=s3 automaticamente quando há creds).
STORAGE_PROVIDER=s3
STORAGE_BUCKET=softmusic
STORAGE_PREFIX=
STORAGE_PRESIGN_EXPIRES=3600
STORAGE_DELETE_LOCAL_AFTER_UPLOAD=true
S3_ENDPOINT_URL=https://9939081e6ba254ac6535099e21fbab2a.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=SUBSTITUA_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=SUBSTITUA_R2_SECRET_ACCESS_KEY
