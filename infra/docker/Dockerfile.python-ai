ARG PYTORCH_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
FROM ${PYTORCH_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ffmpeg via apt puxa mesa/LLVM (~100MB+) e no Jenkins (legacy builder +
# containerd) costuma falhar com: failed to apply diff / Lchown libLLVM-*.so.
# Binário estático + libsndfile (pequeno) evita essa layer.
ARG FFMPEG_STATIC_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      xz-utils \
      libsndfile1 \
    && curl -fsSL "$FFMPEG_STATIC_URL" -o /tmp/ffmpeg.tar.xz \
    && mkdir -p /tmp/ffmpeg \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg --strip-components=1 \
    && install -m 0755 /tmp/ffmpeg/bin/ffmpeg /tmp/ffmpeg/bin/ffprobe /usr/local/bin/ \
    && rm -rf /tmp/ffmpeg /tmp/ffmpeg.tar.xz /var/lib/apt/lists/* \
    && ffmpeg -version >/dev/null \
    && ffprobe -version >/dev/null

# Metadata + entrypoint ANTES do pip: no legacy builder + containerd, criar
# EXPOSE/ENTRYPOINT depois da layer enorme do site-packages falha com
# "NotFound: content digest sha256:...: not found".
COPY apps/python-ai /app/apps/python-ai
COPY infra/docker/python-ai/entrypoint.sh /entrypoint.sh
WORKDIR /app/apps/python-ai
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Última layer de filesystem — não adicionar instruções depois deste RUN.
RUN pip install --no-cache-dir . \
    && chmod +x /entrypoint.sh \
    && mkdir -p uploads models
